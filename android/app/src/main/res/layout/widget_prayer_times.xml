<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_times_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg_gradient"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_glass_inner"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- ===== العنوان ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal_medium"
            android:gravity="center"
            android:text="مواقيت اليوم"
            android:textColor="#FFFFD700"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- خط ذهبي تحت العنوان -->
        <View
            android:layout_width="40dp"
            android:layout_height="1.5dp"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            android:background="#80FFD700" />

        <!-- المدينة -->
        <TextView
            android:id="@+id/wt_loc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/tajawal_medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFADB5BD"
            android:textSize="11sp" />

        <!-- ===== الفجر ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="الفجر"
                android:textColor="#CCF8F9FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/wt_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="—"
                android:textColor="#FFFFD700"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- فاصل -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#20FFFFFF" />

        <!-- ===== الشروق ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="الشروق"
                android:textColor="#CCF8F9FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/wt_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="—"
                android:textColor="#FFFFD700"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- فاصل -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#20FFFFFF" />

        <!-- ===== الظهر ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="الظهر"
                android:textColor="#CCF8F9FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/wt_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="—"
                android:textColor="#FFFFD700"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- فاصل -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#20FFFFFF" />

        <!-- ===== العصر ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="العصر"
                android:textColor="#CCF8F9FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/wt_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="—"
                android:textColor="#FFFFD700"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- فاصل -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#20FFFFFF" />

        <!-- ===== المغرب ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="المغرب"
                android:textColor="#CCF8F9FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/wt_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="—"
                android:textColor="#FFFFD700"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- فاصل -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#20FFFFFF" />

        <!-- ===== العشاء ===== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="العشاء"
                android:textColor="#CCF8F9FA"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/wt_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/tajawal_medium"
                android:text="—"
                android:textColor="#FFFFD700"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </LinearLayout>

    <!-- ===== أذكار المسلم ===== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/tajawal_medium"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="✦ أذكار المسلم ✦"
        android:textColor="#BFFFD700"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>